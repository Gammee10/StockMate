# ==============================================================================
# StockMate Environment Variables Template (.env.example)
# Copy this file to .env.local for local development.
# NEVER COMMIT REAL SECRETS OR .env.local TO GIT.
# ==============================================================================

# Node Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase PostgreSQL Database Connection
# 1. DATABASE_URL: Connection string for Prisma Client.
# For Supabase / PgBouncer, ensure adequate connection limits or use session pooler (port 5432)
# to prevent P2028 timeouts during Prisma interactive transactions.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct session connection for Prisma migrations and schema push (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].supabase.com:5432/postgres"

# Authentication Secrets
# Secure random 32+ character string used to sign session JWTs (generate with: openssl rand -base64 32)
JWT_SECRET="replace-with-a-secure-random-32-character-secret-key"

# Demo Account Phone Bypass (optional: bypasses database-backed login lockout for public demo)
DEMO_LOGIN_PHONE="+251911000000"

# Production Seed Safety Guard (required to be 'true' only if executing demo seed in production)
ALLOW_DEMO_SEED="false"
